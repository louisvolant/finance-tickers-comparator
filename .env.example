# Ticker-Tracker Environment Variables Example

# Secret used to sign HMAC session tokens (32+ chars recommended)
SESSION_SECRET="ticker-tracker-production-super-secret-key-32b"

# Google OAuth 2.0 Credentials (optional in guest mode)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public Application URL for SEO metadata, canonicals & OAuth callback redirects.
# Local development: http://localhost:3000 — production: https://tickertracker.net
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Shared secret for the optional manual trigger endpoint (POST /api/cron/alerts).
# The scheduled scan runs in-process and does not use it. Runtime-only:
# wrangler secret put CRON_SECRET.
CRON_SECRET="replace-with-a-long-random-string"

# Web Push (VAPID). Generate a pair with: node scripts/generate-vapid-keys.mjs
# The public key is intentionally public; the private key is a Worker secret.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contact@your-domain.example"

# Optional build-time max age (days) of the generated market-holiday table
# before `npm run build` regenerates it. Defaults to 30.
MARKET_HOLIDAYS_MAX_AGE_DAYS="30"
